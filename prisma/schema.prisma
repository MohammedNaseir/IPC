// IPC Management Portal — data model per SRS v1.0 §4 (19 entities) plus StoredFile for secure uploads.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  central
  hospital
}

enum VisitStatus {
  in_progress
  completed
}

// `late` is derived at read time from the template due date; only pending/completed are persisted.
enum TrainingStatus {
  pending
  late
  completed
}

enum PolicyCategory {
  policy
  procedure
  form
}

enum OrgDocType {
  org_structure
  job_description
}

enum NotificationType {
  training_overdue
  visit_upcoming
  new_document
}

model User {
  id              String    @id @default(cuid())
  // Not @unique at the Prisma level: uniqueness among active rows is enforced by a partial index
  // (WHERE "deletedAt" IS NULL, see migration 005-soft-delete) so a deleted coordinator's email is
  // immediately reusable. findUnique({ where: { email } }) is therefore not available — use
  // findFirst instead (see src/server/actions/auth.ts).
  email           String
  passwordHash    String
  name            String
  role            Role
  // Unique: SRS §6 allows exactly one coordinator account per hospital. Null for central users.
  // Kept @unique (unlike email) so Hospital.coordinator stays a one-to-one relation — freeing a
  // deleted coordinator's hospital slot is handled in addCoordinator, not here (005-soft-delete
  // research.md R-005).
  hospitalId      String?   @unique
  // Incremented on password/email change to invalidate existing sessions.
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete). Null = active. Set together with deletionEventId when part of
  // a cascade (e.g. the coordinator of a deleted Hospital); deletionEventId stays null otherwise.
  deletedAt       DateTime?
  deletionEventId String?

  hospital      Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  notifications Notification[]
  auditLogs     AuditLog[]
  uploadedFiles StoredFile[]

  @@index([deletedAt])
}

model Hospital {
  id              String    @id @default(cuid())
  name            String
  location        String
  type            String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete). Cascades to the coordinator, and to every Visit/Training/
  // Practitioner/Equipment row scoped to this hospital, except a completed Visit (never deletable).
  deletedAt       DateTime?
  deletionEventId String?

  coordinator   User?
  visits        Visit[]
  trainings     Training[]
  practitioners Practitioner[]
  equipments    Equipment[]
  files         StoredFile[]

  @@index([deletedAt])
}

model Visit {
  id              String      @id @default(cuid())
  hospitalId      String
  visitDate       DateTime
  team            String
  details         String
  reportFileId    String?     @unique
  status          VisitStatus @default(in_progress)
  complianceScore Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  // Soft delete (005-soft-delete). A Visit with status 'completed' MUST NEVER have this set — by
  // any path, including a Hospital cascade, which skips a completed Visit rather than deleting it
  // (SRS reliability requirement; enforced in the Prisma extension, not only in application code).
  deletedAt       DateTime?
  deletionEventId String?

  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  reportFile  StoredFile?       @relation("VisitReport", fields: [reportFileId], references: [id], onDelete: SetNull)
  attachments VisitAttachment[]
  responses   VisitResponse[]

  @@index([hospitalId])
  @@index([deletedAt])
}

model VisitAttachment {
  id         String   @id @default(cuid())
  visitId    String
  fileId     String   @unique
  uploadedAt DateTime @default(now())

  visit Visit      @relation(fields: [visitId], references: [id], onDelete: Restrict)
  file  StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([visitId])
}

model VisitResponse {
  id               String   @id @default(cuid())
  visitId          String
  note             String
  attachmentFileId String?  @unique
  respondentName   String
  respondedAt      DateTime @default(now())

  visit      Visit       @relation(fields: [visitId], references: [id], onDelete: Restrict)
  attachment StoredFile? @relation("VisitResponseAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@index([visitId])
}

model AuditLog {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  performedById   String?
  // Snapshot of the actor's name so the log stays readable and unchanged if the user is later renamed.
  performedByName String
  timestamp       DateTime @default(now())

  performedBy User? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
}

model TrainingTemplate {
  id              String    @id @default(cuid())
  title           String
  description     String
  dueDate         DateTime
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete). Never cascades to Training rows created from this template —
  // those are independent historical records regardless of whether the template still exists.
  deletedAt       DateTime?
  deletionEventId String?

  trainings Training[]

  @@index([deletedAt])
}

model Training {
  id              String         @id @default(cuid())
  templateId      String?
  hospitalId      String
  title           String
  description     String
  deliveredBy     String?
  date            DateTime?
  notes           String?
  status          TrainingStatus @default(pending)
  createdAt       DateTime       @default(now())
  // Soft delete (005-soft-delete).
  deletedAt       DateTime?
  deletionEventId String?

  template    TrainingTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  hospital    Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  attachments TrainingAttachment[]
  attendances TrainingAttendance[]

  @@unique([templateId, hospitalId])
  @@index([hospitalId])
  @@index([deletedAt])
}

model TrainingAttachment {
  id         String   @id @default(cuid())
  trainingId String
  fileId     String   @unique
  uploadedAt DateTime @default(now())

  training Training   @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  file     StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([trainingId])
}

// A row is either one named attendee or the training's total headcount, never both and never
// neither. Enforced by a CHECK constraint, plus a partial unique index allowing at most one
// headcount row per training (see migration 20260927000000_attendance_names).
// Attendance carries no reference to Practitioner — see docs/CLAUDE_REFERENCE.md §8 D-001.
model TrainingAttendance {
  id           String  @id @default(cuid())
  trainingId   String
  attendeeName String?
  headcount    Int?

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
}

model Practitioner {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  role            String
  licenseNumber   String?
  email           String?
  phone           String?
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete).
  deletedAt       DateTime?
  deletionEventId String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([deletedAt])
}

model Equipment {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  type            String
  serialNumber    String?
  status          String?
  lastMaintenance DateTime?
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete).
  deletedAt       DateTime?
  deletionEventId String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([deletedAt])
}

model Policy {
  id              String         @id @default(cuid())
  title           String
  category        PolicyCategory
  version         String         @default("1.0")
  fileId          String         @unique
  uploadedAt      DateTime       @default(now())
  // Soft delete (005-soft-delete).
  deletedAt       DateTime?
  deletionEventId String?

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
}

model OrgDocument {
  id              String     @id @default(cuid())
  title           String
  type            OrgDocType
  fileId          String     @unique
  uploadedAt      DateTime   @default(now())
  // Soft delete (005-soft-delete).
  deletedAt       DateTime?
  deletionEventId String?

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
}

model DocumentCenterFile {
  id              String    @id @default(cuid())
  title           String
  fileId          String    @unique
  uploadedAt      DateTime  @default(now())
  // Soft delete (005-soft-delete).
  deletedAt       DateTime?
  deletionEventId String?

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
}

model Program {
  id              String    @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete). Cascades to every folder and file it contains, at any depth.
  deletedAt       DateTime?
  deletionEventId String?

  folders ProgramFolder[]
  files   ProgramFile[]

  @@index([deletedAt])
}

model ProgramFolder {
  id              String    @id @default(cuid())
  programId       String
  parentFolderId  String?
  name            String
  description     String?
  // Soft delete (005-soft-delete). Cascades to its own subtree (subfolders and files) only.
  deletedAt       DateTime?
  deletionEventId String?

  program      Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  parentFolder ProgramFolder?  @relation("SubFolders", fields: [parentFolderId], references: [id], onDelete: Restrict)
  subFolders   ProgramFolder[] @relation("SubFolders")
  files        ProgramFile[]

  @@index([programId])
  @@index([deletedAt])
}

model ProgramFile {
  id              String    @id @default(cuid())
  programId       String
  folderId        String?
  name            String
  fileId          String    @unique
  createdAt       DateTime  @default(now())
  // Soft delete (005-soft-delete). Unlike other child/attachment rows, a ProgramFile can be
  // deleted on its own (not only cascaded with its folder or program), so it needs its own marker.
  deletedAt       DateTime?
  deletionEventId String?

  program Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  folder  ProgramFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  file    StoredFile     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([programId])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String?
  // Source record (visit/training/document id), used to avoid duplicate reminders.
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, entityId])
}

// Uploaded file metadata; bytes live on disk under UPLOADS_DIR. hospitalId scopes download access: null = cluster-wide library visible to all signed-in users.
model StoredFile {
  id           String   @id @default(cuid())
  name         String
  mimeType     String
  size         Int
  path         String
  hospitalId   String?
  uploadedById String?
  createdAt    DateTime @default(now())

  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  visitReport        Visit?              @relation("VisitReport")
  visitAttachment    VisitAttachment?
  visitResponse      VisitResponse?      @relation("VisitResponseAttachment")
  trainingAttachment TrainingAttachment?
  policy             Policy?
  orgDocument        OrgDocument?
  documentCenterFile DocumentCenterFile?
  programFile        ProgramFile?

  @@index([hospitalId])
}
