// Prisma Schema for IPC Management Portal (منصة إدارة مكافحة العدوى)
// As specified in the SRS document v1.0
// Compatible with Neon.tech PostgreSQL Serverless

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  central
  hospital
}

enum VisitStatus {
  in_progress
  completed
}

enum TrainingStatus {
  pending
  late
  completed
}

enum PolicyCategory {
  policy
  procedure
  form
}

enum OrgDocType {
  org_structure
  job_description
}

enum NotificationType {
  training_overdue
  visit_upcoming
  new_document
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String         @default("مستخدم")
  role         Role           @default(hospital)
  hospitalId   String?
  createdAt    DateTime       @default(now())

  hospital     Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  notifications Notification[]
}

model Hospital {
  id               String         @id @default(cuid())
  name             String
  location         String
  type             String
  coordinatorName  String         @default("")
  coordinatorEmail String         @default("")
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  users            User[]
  visits           Visit[]
  trainings        Training[]
  practitioners    Practitioner[]
  equipments       Equipment[]
}

model Visit {
  id          String            @id @default(cuid())
  hospitalId  String
  visitDate   DateTime
  team        String
  details     String
  reportUrl   String            @default("")
  reportName  String            @default("تقرير الزيارة")
  status      VisitStatus       @default(in_progress)
  complianceScore Float?        @default(85.0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  attachments VisitAttachment[]
  responses   VisitResponse[]
}

model VisitAttachment {
  id         String   @id @default(cuid())
  visitId    String
  fileName   String   @default("مرفق")
  fileUrl    String
  uploadedAt DateTime @default(now())

  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model VisitResponse {
  id             String   @id @default(cuid())
  visitId        String
  note           String
  attachmentUrl  String?
  attachmentName String?
  respondentName String   @default("منسق المستشفى")
  respondedAt    DateTime @default(now())

  visit          Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // Visit, Training, Hospital, etc.
  entityId    String
  action      String   // Create, Update, Response, Complete, etc.
  performedBy String
  timestamp   DateTime @default(now())
}

model TrainingTemplate {
  id          String     @id @default(cuid())
  title       String
  description String
  dueDate     DateTime
  createdAt   DateTime   @default(now())

  trainings   Training[]
}

model Training {
  id          String               @id @default(cuid())
  templateId  String?
  hospitalId  String
  title       String
  description String
  deliveredBy String               @default("")
  date        DateTime?
  status      TrainingStatus       @default(pending)
  createdAt   DateTime             @default(now())

  template    TrainingTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  hospital    Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  attachments TrainingAttachment[]
  attendances TrainingAttendance[]
}

model TrainingAttachment {
  id         String   @id @default(cuid())
  trainingId String
  fileName   String   @default("مرفق تدريب")
  fileUrl    String
  uploadedAt DateTime @default(now())

  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
}

model TrainingAttendance {
  id             String        @id @default(cuid())
  trainingId     String
  practitionerId String?
  headcount      Int?

  training       Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
}

model Practitioner {
  id            String   @id @default(cuid())
  hospitalId    String
  name          String
  role          String   // Specialization or Job title
  licenseNumber String?
  contact       String?

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  attendances   TrainingAttendance[]
}

model Equipment {
  id           String   @id @default(cuid())
  hospitalId   String
  name         String
  type         String
  serialNumber String?
  status       String?

  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Policy {
  id         String         @id @default(cuid())
  title      String
  category   PolicyCategory @default(policy)
  fileUrl    String
  fileName   String         @default("وثيقة سياسة")
  version    String?        @default("1.0")
  uploadedAt DateTime       @default(now())
}

model OrgDocument {
  id         String     @id @default(cuid())
  title      String
  type       OrgDocType
  fileUrl    String
  fileName   String     @default("مستند تنظيمي")
  uploadedAt DateTime   @default(now())
}

model DocumentCenterFile {
  id         String   @id @default(cuid())
  title      String
  fileUrl    String
  fileName   String   @default("وثيقة")
  category   String?  @default("عام")
  uploadedAt DateTime @default(now())
}

model Program {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())

  folders     ProgramFolder[]
  files       ProgramFile[]
}

model ProgramFolder {
  id             String          @id @default(cuid())
  programId      String
  parentFolderId String?
  name           String

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  parentFolder   ProgramFolder?  @relation("SubFolders", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subFolders     ProgramFolder[] @relation("SubFolders")
  files          ProgramFile[]
}

model ProgramFile {
  id        String         @id @default(cuid())
  programId String
  folderId  String?
  name      String
  fileUrl   String
  fileSize  String?        @default("1.2 MB")
  createdAt DateTime       @default(now())

  program   Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  folder    ProgramFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}
