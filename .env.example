# All variables are server-only. Never prefix any of them with NEXT_PUBLIC_.

# Neon pooled connection string (used by the running app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct (non-pooled) connection string (used by `prisma migrate deploy`).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Session signing key, at least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Bearer token required by /api/cron/notifications (overdue-training and upcoming-visit reminders).
CRON_SECRET=""
